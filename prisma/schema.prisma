generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// TOUR
// ======================================================

model Tour {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("تومان")
  discountedPrice    Decimal? @db.Decimal(12, 2)
  discountPercentage Int      @default(0)

  shortDescription String?
  description      String?

  image      String?
  thumbImage String?

  destination String
  country     String?
  city        String?

  duration String?

  departureDate DateTime?
  returnDate    DateTime?

  capacity          Int?
  remainingCapacity Int?

  accommodation  String?
  transportation String?
  meals          String?
  guide          String?
  meetingPoint   String?
  mapUrl         String?

  highlights   String[] @default([])
  included     String[] @default([])
  excluded     String[] @default([])
  requirements String[] @default([])

  itinerary Json     @default("[]")
  gallery   String[] @default([])

  isSpecial   Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isPublished])
  @@index([destination])
  @@index([country])
  @@index([city])
  @@index([departureDate])
  @@map("tours")
}

// ======================================================
// TRAIN TICKET
// ======================================================

model TrainTicket {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("تومان")
  discountedPrice    Decimal? @db.Decimal(12, 2)
  discountPercentage Int      @default(0)

  shortDescription String?
  description      String?

  image      String?
  thumbImage String?
  gallery    String[] @default([])

  origin      String
  destination String

  originCity      String?
  destinationCity String?

  originStation      String?
  destinationStation String?

  originCode      String?
  destinationCode String?

  trainCompany String?
  trainName    String?
  trainNumber  String?
  trainType    String?

  departureDate DateTime
  arrivalDate   DateTime?

  departureTime String?
  arrivalTime   String?

  duration String?

  carriageType String?
  seatType     String?

  capacity          Int?
  remainingCapacity Int?

  baggage String?

  refundPolicy       String?
  cancellationPolicy String?

  facilities   String[] @default([])
  requirements String[] @default([])

  isSpecial   Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isPublished])
  @@index([origin])
  @@index([destination])
  @@index([departureDate])
  @@index([trainCompany])
  @@map("train_tickets")
}

