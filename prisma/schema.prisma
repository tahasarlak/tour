  originCity      String?
  destinationCity String?

  originAirport      String?
  destinationAirport String?

  originAirportCode      String?
  destinationAirportCode String?

  airline      String?
  airlineCode  String?
  flightNumber String?

  departureDate DateTime
  arrivalDate   DateTime?

  departureTime String?
  arrivalTime   String?

  duration String?

  cabinClass String?

  baggage     String?
