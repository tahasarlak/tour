// ======================================================
// ACCOMMODATION
// ======================================================

model Accommodation {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("تومان")
  discountedPrice    Decimal? @db.Decimal(12, 2)
  discountPercentage Int      @default(0)

  shortDescription String?
  description      String?

  country String?
  city    String
  address String?

  latitude  Float?
  longitude Float?
  mapUrl    String?

  image      String?
  thumbImage String?
  gallery    String[] @default([])

  accommodationType String?
  starRating        Int?

  roomType String?

  capacity          Int?
  remainingCapacity Int?
  rooms             Int?

  checkInTime  String?
  checkOutTime String?

  minimumNights Int?

  mealPlan String?

  amenities String[] @default([])
  services  String[] @default([])

  cancellationPolicy String?
  houseRules         String?

  requirements String[] @default([])

  isSpecial   Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isPublished])
  @@index([country])
  @@index([city])
  @@index([starRating])
  @@map("accommodations")
