generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum ProductType {
  TOUR
  TRAIN
  FLIGHT
  ACCOMMODATION
  VISA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingType {
  TOUR
  TRAIN
  FLIGHT
  ACCOMMODATION
  VISA
}

// ======================================================
// TOUR
// ======================================================

model Tour {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique

  name               String

  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("₽")

  discountedPrice    Decimal?  @db.Decimal(12, 2)
  discountPercentage Int       @default(0)

  shortDescription   String?
  description        String?

  image              String?
  thumbImage         String?

  destination        String
  country            String?
  city               String?

  duration           String?

  departureDate      DateTime?
  returnDate         DateTime?

  capacity           Int?
  remainingCapacity  Int?

  accommodation      String?
  transportation     String?
  meals              String?
  guide              String?

  meetingPoint       String?
  mapUrl             String?

  highlights         String[]  @default([])
  included           String[]  @default([])
  excluded           String[]  @default([])
  requirements       String[]  @default([])

  itinerary          Json      @default("[]")

  gallery            String[]  @default([])

  isSpecial          Boolean   @default(false)
  isPublished        Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@index([isPublished])
  @@index([destination])
  @@index([country])
  @@index([city])
  @@index([departureDate])
  @@map("tours")
}

// ======================================================
// TRAIN TICKET
// ======================================================

model TrainTicket {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique

  name               String

  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("₽")

  discountedPrice    Decimal?  @db.Decimal(12, 2)
  discountPercentage Int       @default(0)

  shortDescription   String?
  description        String?

  image              String?
  thumbImage         String?
  gallery            String[]  @default([])

  // ------------------------------
  // ROUTE
  // ------------------------------

  origin             String
  destination        String

  originCity         String?
  destinationCity    String?

  originStation      String?
  destinationStation String?

  originCode         String?
  destinationCode    String?

  // ------------------------------
  // TRAIN
  // ------------------------------

  trainCompany       String?
  trainName          String?
  trainNumber        String?

  trainType          String?

  // ------------------------------
  // SCHEDULE
  // ------------------------------

  departureDate      DateTime
  arrivalDate        DateTime?

  departureTime      String?
  arrivalTime        String?

  duration           String?

  // ------------------------------
  // TICKET
  // ------------------------------

  carriageType       String?
  seatType           String?

  capacity           Int?
  remainingCapacity  Int?

  baggage            String?

  refundPolicy       String?
  cancellationPolicy String?

  facilities         String[]  @default([])
  requirements       String[]  @default([])

  isSpecial          Boolean   @default(false)
  isPublished        Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@index([isPublished])
  @@index([origin])
  @@index([destination])
  @@index([departureDate])
  @@index([trainCompany])
  @@map("train_tickets")
}

// ======================================================
// FLIGHT TICKET
// ======================================================

model FlightTicket {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique

  name               String

  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("₽")

  discountedPrice    Decimal?  @db.Decimal(12, 2)
  discountPercentage Int       @default(0)

  shortDescription   String?
  description        String?

  image              String?
  thumbImage         String?
  gallery            String[]  @default([])

  // ------------------------------
  // ROUTE
  // ------------------------------

  origin             String
  destination        String

  originCity         String?
  destinationCity    String?

  originAirport      String?
  destinationAirport String?

  originAirportCode  String?
  destinationAirportCode String?

  // ------------------------------
  // AIRLINE
  // ------------------------------

  airline            String?
  airlineCode        String?

  flightNumber       String?

  // ------------------------------
  // SCHEDULE
  // ------------------------------

  departureDate      DateTime
  arrivalDate        DateTime?

  departureTime      String?
  arrivalTime        String?

  duration           String?

  // ------------------------------
  // FLIGHT DETAILS
  // ------------------------------

  cabinClass         String?

  baggage            String?
  handBaggage        String?

  stops              Int       @default(0)

  refundable         Boolean   @default(false)

  refundPolicy       String?
  cancellationPolicy String?

  facilities         String[]  @default([])
  requirements       String[]  @default([])

  // ------------------------------
  // STATUS
  // ------------------------------

  capacity           Int?
  remainingCapacity  Int?

  isSpecial          Boolean   @default(false)
  isPublished        Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@index([isPublished])
  @@index([origin])
  @@index([destination])
  @@index([departureDate])
  @@index([airline])
  @@map("flight_tickets")
}

// ======================================================
// ACCOMMODATION
// ======================================================

model Accommodation {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique

  name               String

  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("₽")

  discountedPrice    Decimal?  @db.Decimal(12, 2)
  discountPercentage Int       @default(0)

  shortDescription   String?
  description        String?

  // ------------------------------
  // LOCATION
  // ------------------------------

  country            String?
  city               String
  address            String?

  latitude           Float?
  longitude          Float?

  mapUrl             String?

  // ------------------------------
  // IMAGES
  // ------------------------------

  image              String?
  thumbImage         String?
  gallery            String[]  @default([])

  // ------------------------------
  // ACCOMMODATION
  // ------------------------------

  accommodationType  String?
  starRating         Int?

  roomType           String?

  capacity           Int?
  remainingCapacity  Int?

  rooms              Int?

  // ------------------------------
  // STAY
  // ------------------------------

  checkInTime        String?
  checkOutTime       String?

  minimumNights      Int?

  // ------------------------------
  // MEALS
  // ------------------------------

  mealPlan           String?

  // ------------------------------
  // FACILITIES
  // ------------------------------

  amenities          String[]  @default([])
  services           String[]  @default([])

  // ------------------------------
  // POLICIES
  // ------------------------------

  cancellationPolicy String?
  houseRules         String?

  requirements       String[]  @default([])

  isSpecial          Boolean   @default(false)
  isPublished        Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@index([isPublished])
  @@index([country])
  @@index([city])
  @@index([starRating])
  @@map("accommodations")
}

// ======================================================
// TOURIST VISA
// ======================================================

model TouristVisa {
  id                 Int       @id @default(autoincrement())
  slug               String    @unique

  name               String

  price              Decimal   @db.Decimal(12, 2)
  currency           String    @default("₽")

  discountedPrice    Decimal?  @db.Decimal(12, 2)
  discountPercentage Int       @default(0)

  shortDescription   String?
  description        String?

  image              String?
  thumbImage         String?
  gallery            String[]  @default([])

  // ------------------------------
  // VISA DESTINATION
  // ------------------------------

  country            String
  countryCode        String?

  destination        String?

  // ------------------------------
  // VISA TYPE
  // ------------------------------

  visaType           String?
  entryType          String?

  validityPeriod     String?
  stayDuration       String?

  // ------------------------------
  // PROCESSING
  // ------------------------------

  processingTime     String?

  urgentProcessing   Boolean   @default(false)
  urgentProcessingTime String?

  // ------------------------------
  // REQUIREMENTS
  // ------------------------------

  requirements       String[]  @default([])

  requiredDocuments  String[]  @default([])

  additionalDocuments String[] @default([])

  // ------------------------------
  // SERVICES
  // ------------------------------

  included            String[] @default([])
  excluded            String[] @default([])

  interviewRequired   Boolean  @default(false)

  biometricsRequired  Boolean  @default(false)

  // ------------------------------
  // POLICIES
  // ------------------------------

  cancellationPolicy String?

  notes              String?

  // ------------------------------
  // STATUS
  // ------------------------------

  isSpecial          Boolean   @default(false)
  isPublished        Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings           Booking[]

  @@index([isPublished])
  @@index([country])
  @@index([countryCode])
  @@map("tourist_visas")
}

// ======================================================
// BOOKING
// ======================================================

model Booking {
  id                 Int           @id @default(autoincrement())

  bookingNumber      String        @unique

  type               BookingType

  status             BookingStatus @default(PENDING)

  paymentStatus      PaymentStatus @default(UNPAID)

  // ------------------------------
  // CUSTOMER
  // ------------------------------

  firstName          String
  lastName           String

  phone              String
  email              String?

  nationality        String?

  passportNumber     String?
  passportExpiry     DateTime?

  // ------------------------------
  // PASSENGERS / GUESTS
  // ------------------------------

  adults             Int           @default(1)
  children           Int           @default(0)
  infants            Int           @default(0)

  // ------------------------------
  // PRICE
  // ------------------------------

  quantity           Int           @default(1)

  unitPrice          Decimal       @db.Decimal(12, 2)

  totalPrice         Decimal       @db.Decimal(12, 2)

  currency           String        @default("₽")

  // ------------------------------
  // PRODUCT RELATIONS
  // ------------------------------

  tourId             Int?
  tour               Tour?         @relation(fields: [tourId], references: [id], onDelete: SetNull)

  trainTicketId      Int?
  trainTicket        TrainTicket?  @relation(fields: [trainTicketId], references: [id], onDelete: SetNull)

  flightTicketId     Int?
  flightTicket       FlightTicket? @relation(fields: [flightTicketId], references: [id], onDelete: SetNull)

  accommodationId   Int?
  accommodation      Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: SetNull)

  touristVisaId      Int?
  touristVisa        TouristVisa?  @relation(fields: [touristVisaId], references: [id], onDelete: SetNull)

  // ------------------------------
  // EXTRA INFORMATION
  // ------------------------------

  customerNote       String?

  adminNote          String?

  // اطلاعات مسافر/مهمان
  passengerData      Json?

  // ------------------------------
  // PAYMENT
  // ------------------------------

  paymentId          String?

  paymentReference   String?

  paidAt             DateTime?

  // ------------------------------
  // DATES
  // ------------------------------

  createdAt          DateTime       @default(now())

  updatedAt          DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([paymentStatus])
  @@index([phone])
  @@index([email])
  @@index([createdAt])

  @@map("bookings")
}

// ======================================================
// ADMIN
// ======================================================

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}