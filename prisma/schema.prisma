// ======================================================
// TOURIST VISA
// ======================================================

model TouristVisa {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("تومان")
  discountedPrice    Decimal? @db.Decimal(12, 2)
  discountPercentage Int      @default(0)

  shortDescription String?
  description      String?

  image      String?
  thumbImage String?
  gallery    String[] @default([])

  country     String
  countryCode String?

  destination String?

  visaType  String?
  entryType String?

  validityPeriod String?
  stayDuration   String?

  processingTime String?

  urgentProcessing     Boolean @default(false)
  urgentProcessingTime String?

  requirements        String[] @default([])
  requiredDocuments   String[] @default([])
  additionalDocuments String[] @default([])

  included String[] @default([])
  excluded String[] @default([])

  interviewRequired  Boolean @default(false)
  biometricsRequired Boolean @default(false)

  cancellationPolicy String?
  notes              String?

  isSpecial   Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isPublished])
  @@index([country])
  @@index([countryCode])
  @@map("tourist_visas")
}

// ======================================================
// BOOKING
// ======================================================

model Booking {
  id Int @id @default(autoincrement())

  bookingNumber String @unique

  type BookingType

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  firstName String
  lastName  String

  phone String
  email String?

  nationality String?

  passportNumber String?
  passportExpiry DateTime?

  adults   Int @default(1)
  children Int @default(0)
  infants  Int @default(0)

  quantity Int @default(1)

  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  currency String @default("تومان")

  // ====================================================
  // PRODUCT IDS
  // ====================================================

  tourId          Int?
  trainTicketId   Int?
  flightTicketId  Int?
  busTicketId     Int?
  accommodationId Int?
  touristVisaId   Int?

  // ====================================================
  // NOTES / PAYMENT
  // ====================================================

  customerNote String?
  adminNote    String?

  passengerData Json?

  paymentId        String?
  paymentReference String?
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ====================================================
  // RELATIONS
  // ====================================================

  tour Tour? @relation(fields: [tourId], references: [id])

  trainTicket TrainTicket? @relation(fields: [trainTicketId], references: [id])

  flightTicket FlightTicket? @relation(fields: [flightTicketId], references: [id])

  busTicket BusTicket? @relation(fields: [busTicketId], references: [id])

  accommodation Accommodation? @relation(fields: [accommodationId], references: [id])

  touristVisa TouristVisa? @relation(fields: [touristVisaId], references: [id])

  @@index([type])
  @@index([status])
  @@index([paymentStatus])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([busTicketId])
  @@map("bookings")
}

// ======================================================
// ADMIN
// ======================================================

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ======================================================
// PRODUCT TYPE
// ======================================================

enum ProductType {
  TOUR
  TRAIN
  FLIGHT
  BUS
  ACCOMMODATION
  VISA
}

// ======================================================
// BOOKING STATUS
// ======================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

// ======================================================
// PAYMENT STATUS
// ======================================================

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ======================================================
// BOOKING TYPE
// ======================================================

enum BookingType {
  TOUR
  TRAIN
  FLIGHT
  BUS
  ACCOMMODATION
  VISA
}
